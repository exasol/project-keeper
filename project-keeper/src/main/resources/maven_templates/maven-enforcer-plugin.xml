<plugin>
    <groupId>org.apache.maven.plugins</groupId>
    <artifactId>maven-enforcer-plugin</artifactId>
    <version>3.6.3</version>
    <executions>
        <execution>
            <id>enforce-maven</id>
            <goals>
                <goal>enforce</goal>
            </goals>
            <configuration>
                <rules>
                    <requireMavenVersion>
                        <version>3.10.0</version>
                    </requireMavenVersion>
                    <requireJavaVersion>
                        <!-- This checks the Java runtime running Maven. Compilation uses the configured toolchain. -->
                        <version>[17,)</version>
                        <message>Project Keeper requires Maven to run on Java 17 or newer. The configured java.version is used for compilation and testing through Maven Toolchains.</message>
                    </requireJavaVersion>
                </rules>
            </configuration>
        </execution>
    </executions>
</plugin>
